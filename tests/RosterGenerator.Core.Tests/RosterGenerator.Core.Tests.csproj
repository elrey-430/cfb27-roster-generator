<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless" Version="11.0.10" />
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RosterGenerator.Core\RosterGenerator.Core.csproj" />
    <ProjectReference Include="..\..\src\RosterGenerator.Gui\RosterGenerator.Gui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tests run against the real mapping files so the shipped data stays valid. -->
    <None Include="..\..\data\TeamMappings.json" Link="Fixtures\TeamMappings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\PositionMappings.json" Link="Fixtures\PositionMappings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\RatingModels.json" Link="Fixtures\RatingModels.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\OverallFormulas.json" Link="Fixtures\OverallFormulas.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\ArchetypeRules.json" Link="Fixtures\ArchetypeRules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\ArchetypeProfiles.json" Link="Fixtures\ArchetypeProfiles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\RosterDepth.json" Link="Fixtures\RosterDepth.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\EquipmentEras.json" Link="Fixtures\EquipmentEras.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The 2023 FSU regression fixtures (input, donor dynasty, expected output). -->
    <None Include="..\..\Tests\**" Link="Tests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped templates, so the one users start from stays usable.
         Linked under Fixtures rather than a top-level Templates: the GUI
         project reference already puts the same files in "templates", and on a
         case-sensitive filesystem MSBuild treats the two destinations as one
         on a clean build and copies only the GUI's, so the tests read a path
         that does not exist. -->
    <None Include="..\..\templates\*.csv" Link="Fixtures\Templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
